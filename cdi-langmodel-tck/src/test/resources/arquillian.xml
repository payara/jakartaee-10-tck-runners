<?xml version="1.0" encoding="UTF-8"?>
<arquillian xmlns="http://jboss.org/schema/arquillian"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="http://jboss.org/schema/arquillian http://jboss.org/schema/arquillian/arquillian_1_0.xsd">

    <defaultProtocol type="Servlet 5.0"/>

    <engine>
        <!-- Uncomment to export test archives for debug purposes -->
        <!-- property name="deploymentExportPath">target/</property -->
    </engine>

    <container qualifier="payara-managed" default="true"/>

    <container qualifier="payara-micro">
        <configuration>
            <property name="microJar">${payara.micro.jar}</property>
            <property name="cmdOptions">-ea</property>
            <property name="extraMicroOptions">--addlibs ${cdi.lang.model.jar}</property>
        </configuration>
    </container>
</arquillian>