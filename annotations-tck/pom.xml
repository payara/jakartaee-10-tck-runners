<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>fish.payara.jakarta.tests.tck</groupId>
        <artifactId>tck</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>annotations-tck</artifactId>
    <packaging>pom</packaging>

    <name>TCK: Annotations</name>

    <properties>
        <tck.home>${project.build.directory}/annotations-tck</tck.home>
        <tck.tests.home>${tck.home}/src/com/sun/ts/tests/signaturetest/caj</tck.tests.home>
        <jimage.dir>${project.build.directory}/jdk-bundle</jimage.dir>
        <tck.download.url>https://download.eclipse.org/jakartaee/annotations/2.1/jakarta-annotations-tck-${jakarta-annotations-tck.version}.zip</tck.download.url>
        <harness.log.port>2000</harness.log.port>
    </properties>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-install-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-install</id>
                        <phase>disabled</phase>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>com.googlecode.maven-download-plugin</groupId>
                <artifactId>download-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>download-ant</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>wget</goal>
                        </goals>
                        <configuration>
                            <skip>${skipTests}</skip>
                            <url>${ant.zip.url}</url>
                            <unpack>true</unpack>
                        </configuration>
                    </execution>
                    <execution>
                        <id>download-annotations-tck</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>wget</goal>
                        </goals>
                        <configuration>
                            <skip>${skipTests}</skip>
                            <url>${tck.download.url}</url>
                            <unpack>true</unpack>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <dependencies>
                    <dependency>
                        <groupId>org.apache.ant</groupId>
                        <artifactId>ant</artifactId>
                        <version>${ant.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>ant-contrib</groupId>
                        <artifactId>ant-contrib</artifactId>
                        <version>1.0b3</version>
                        <exclusions>
                            <exclusion>
                                <groupId>ant</groupId>
                                <artifactId>ant</artifactId>
                            </exclusion>
                        </exclusions>
                    </dependency>
                </dependencies>
                <configuration>
                    <skip>${skipTests}</skip>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-tck</id>
                        <phase>pre-integration-test</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target xmlns:if="ant:if" xmlns:unless="ant:unless">
                                <taskdef resource="net/sf/antcontrib/antcontrib.properties"
                                         classpathref="maven.plugin.classpath" />

                                <!-- Extract JDK modules required for signature testing -->
                                <mkdir dir="${jimage.dir}"/>
                                <exec executable="${java.home}/bin/jimage">
                                    <arg value="extract"/>
                                    <arg value="--dir=${jimage.dir}"/>
                                    <arg value="${java.home}/lib/modules"/>
                                </exec>

                                <macrodef name="tck-setting">
                                    <attribute name="key" />
                                    <attribute name="value" />
                                    <sequential>
                                        <replaceregexp file="${tck.home}/bin/ts.jte" byline="true"
                                                       match="@{key}=.*" replace="@{key}=@{value}" />
                                    </sequential>
                                </macrodef>

                                <!-- Configure TCK environment properties (Section 3 of the guide) -->
                                <tck-setting key="work.dir"         value="${tck.home}/annotationswork/annotations"/>
                                <tck-setting key="report.dir"       value="${tck.home}/annotationsreport/annotations"/>
                                <tck-setting key="harness.log.port" value="${harness.log.port}"/>
                                <tck-setting key="jimage.dir"       value="${jimage.dir}"/>
                                <!-- local.classes feeds into ts.run.classpath → CLASSPATH for the test JVM;
                                     reflection mode needs the annotation API jar loadable via Class.forName() -->
                                <tck-setting key="local.classes"    value="${payara.home}/glassfish/modules/jakarta.annotation-api.jar"/>
                                <tck-setting key="sigTestClasspath" value="${payara.home}/glassfish/modules/jakarta.annotation-api.jar${pathsep}${jimage.dir}/java.base${pathsep}${jimage.dir}/java.rmi${pathsep}${jimage.dir}/java.sql${pathsep}${jimage.dir}/java.naming"/>

                                <!-- jakarta.annotation.ManagedBean was removed in Jakarta EE 10 -->
                                <tck-setting key="ca.sig.managedbean" value="false"/>

                                <!-- Disable security manager to support JDK 17+ -->
                                <replace file="${tck.home}/bin/xml/ts.top.import.xml">
                                    <replacetoken><![CDATA[<jvmarg value="-Xmx512m"/>]]></replacetoken>
                                    <replacevalue><![CDATA[<jvmarg value="-Xmx512m"/>
                                <jvmarg value="-Djavatest.security.noSecurityManager=true"/>]]></replacevalue>
                                </replace>

                                <replace file="${tck.home}/bin/xml/ts.top.import.xml" if:set="suspend-tck">
                                    <replacetoken><![CDATA[<jvmarg value="-Xmx512m"/>]]></replacetoken>
                                    <replacevalue><![CDATA[<jvmarg value="-Xmx512m"/>
                                <jvmarg value="-agentlib:jdwp=transport=dt_socket,server=y,suspend=y,address=9008"/>]]></replacevalue>
                                </replace>

                                <mkdir dir="${tck.home}/annotationswork/annotations"/>
                                <mkdir dir="${tck.home}/annotationsreport/annotations"/>
                            </target>
                        </configuration>
                    </execution>

                    <execution>
                        <id>run-tck-tests</id>
                        <phase>integration-test</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target xmlns:if="ant:if" xmlns:unless="ant:unless">
                                <taskdef resource="net/sf/antcontrib/antcontrib.properties"
                                         classpathref="maven.plugin.classpath" />

                                <echo level="info" message="Start running all Annotations TCK tests"/>
                                <exec executable="${ant.executable}" dir="${tck.tests.home}" resultproperty="testResult">
                                    <arg value="-Dts.home=${tck.home}"/>
                                    <arg value="-Dmultiple.tests=${run.test}" if:set="run.test"/>
                                    <arg value="run.all" unless:set="run.test"/>
                                    <arg value="runclient"  if:set="run.test"/>
                                    <env key="LC_ALL" value="C"/>
                                </exec>

                                <if>
                                    <not>
                                        <equals arg1="${testResult}" arg2="0"/>
                                    </not>
                                    <then>
                                        <echo message="Running Annotations TCK tests failed."/>
                                    </then>
                                </if>

                                <fail message="Running Annotations TCK tests failed." status="${testResult}">
                                    <condition>
                                        <not>
                                            <equals arg1="${testResult}" arg2="0"/>
                                        </not>
                                    </condition>
                                </fail>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
