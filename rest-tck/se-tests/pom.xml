<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>fish.payara.jakarta.tests.tck</groupId>
        <artifactId>rest-tck</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>rest-tck-se-tests</artifactId>

    <dependencies>
        <!-- ../tck-download/jakarta-rest-tck installs TCK artifacts -->
        <dependency>
            <groupId>jakarta.ws.rs</groupId>
            <artifactId>jakarta-restful-ws-tck</artifactId>
            <version>${jakarta-rest-tck.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>fish.payara.arquillian</groupId>
            <artifactId>arquillian-payara-server-remote</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.jboss.arquillian.junit5</groupId>
            <artifactId>arquillian-junit5-container</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.jboss.arquillian.protocol</groupId>
            <artifactId>arquillian-protocol-servlet</artifactId>
        </dependency>

        <dependency>
            <groupId>org.hamcrest</groupId>
            <artifactId>hamcrest</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- TCK runtime dependencies -->
        <dependency>
            <groupId>com.sun.xml.bind</groupId>
            <artifactId>jaxb-impl</artifactId>
            <version>4.0.1</version>
            <scope>runtime</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <id>se-tests</id>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>

                        <configuration>
                            <dependenciesToScan>jakarta.ws.rs:jakarta-restful-ws-tck</dependenciesToScan>
                            <includes>
                                <include>**/SeBootstrapIT.java</include>
                            </includes>
                            <additionalClasspathElements>
                                <additionalClasspathElement>${payara.home}/glassfish/modules/jersey-server.jar</additionalClasspathElement>
                                <additionalClasspathElement>${payara.home}/glassfish/modules/jersey-client.jar</additionalClasspathElement>
                                <additionalClasspathElement>${payara.home}/glassfish/modules/jersey-common.jar</additionalClasspathElement>
                                <additionalClasspathElement>${payara.home}/glassfish/modules/jersey-media-sse.jar</additionalClasspathElement>
                                <additionalClasspathElement>${payara.home}/glassfish/modules/jersey-container-grizzly2-http.jar</additionalClasspathElement>
                                <additionalClasspathElement>${payara.home}/glassfish/modules/jersey-container-servlet.jar</additionalClasspathElement>
                                <additionalClasspathElement>${payara.home}/glassfish/modules/jersey-container-servlet-core.jar</additionalClasspathElement>
                                <additionalClasspathElement>${payara.home}/glassfish/modules/jersey-media-json-binding.jar</additionalClasspathElement>
                                <additionalClasspathElement>${payara.home}/glassfish/modules/jersey-media-jaxb.jar</additionalClasspathElement>
                                <additionalClasspathElement>${payara.home}/glassfish/modules/jakarta.ws.rs-api.jar</additionalClasspathElement>
                                <additionalClasspathElement>${payara.home}/glassfish/modules/jakarta.xml.bind-api.jar</additionalClasspathElement>
                                <additionalClasspathElement>${payara.home}/glassfish/modules/jakarta.json.bind-api.jar</additionalClasspathElement>
                                <additionalClasspathElement>${payara.home}/glassfish/modules/jakarta.json.jar</additionalClasspathElement>
                                <additionalClasspathElement>${payara.home}/glassfish/modules/parsson.jar</additionalClasspathElement>
                                <additionalClasspathElement>${payara.home}/glassfish/modules/hk2-locator.jar</additionalClasspathElement>
                                <additionalClasspathElement>${payara.home}/glassfish/modules/jaxb-osgi.jar</additionalClasspathElement>
                                <additionalClasspathElement>${payara.home}/glassfish/modules/yasson.jar</additionalClasspathElement>
                                <additionalClasspathElement>${payara.home}/glassfish/modules/nucleus-grizzly-all.jar</additionalClasspathElement>
                                <additionalClasspathElement>${payara.home}/glassfish/modules/jakarta.activation-api.jar</additionalClasspathElement>
                                <additionalClasspathElement>${payara.home}/glassfish/modules/angus-activation.jar</additionalClasspathElement>
                                <additionalClasspathElement>${payara.home}/glassfish/modules/jersey-hk2.jar</additionalClasspathElement>
                                <additionalClasspathElement>${payara.home}/glassfish/modules/hk2-api.jar</additionalClasspathElement>
                                <additionalClasspathElement>${payara.home}/glassfish/modules/hk2-utils.jar</additionalClasspathElement>
                                <additionalClasspathElement>${payara.home}/glassfish/modules/jakarta.inject-api.jar</additionalClasspathElement>
                                <additionalClasspathElement>${payara.home}/glassfish/modules/jakarta.validation-api.jar</additionalClasspathElement>
                            </additionalClasspathElements>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>payara-micro-managed</id>
            <properties>
                <!-- Micro ships no server layout. Extract its impl jars into a synthesized
                     glassfish/modules dir below and point payara.home there, so the base
                     ${payara.home}/glassfish/modules classpath resolves to the Micro jars. -->
                <payara.home>${project.build.directory}/micro-home</payara.home>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>extract-micro-runtime</id>
                                <phase>pre-integration-test</phase>
                                <goals>
                                    <goal>unpack</goal>
                                </goals>
                                <configuration>
                                    <artifactItems>
                                        <artifactItem>
                                            <groupId>fish.payara.extras</groupId>
                                            <artifactId>payara-micro</artifactId>
                                            <version>${payara.version}</version>
                                            <type>jar</type>
                                            <overWrite>yes</overWrite>
                                            <outputDirectory>${project.build.directory}/micro-home/glassfish/modules</outputDirectory>
                                            <!-- Drop the MICRO-INF/runtime/ prefix so jars land directly in glassfish/modules. -->
                                            <fileMappers>
                                                <fileMapper implementation="org.codehaus.plexus.components.io.filemappers.FlattenFileMapper"/>
                                            </fileMappers>
                                            <includes>
                                                MICRO-INF/runtime/jersey-server.jar,
                                                MICRO-INF/runtime/jersey-client.jar,
                                                MICRO-INF/runtime/jersey-common.jar,
                                                MICRO-INF/runtime/jersey-media-sse.jar,
                                                MICRO-INF/runtime/jersey-container-grizzly2-http.jar,
                                                MICRO-INF/runtime/jersey-container-servlet.jar,
                                                MICRO-INF/runtime/jersey-media-json-binding.jar,
                                                MICRO-INF/runtime/jersey-media-jaxb.jar,
                                                MICRO-INF/runtime/jersey-hk2.jar,
                                                MICRO-INF/runtime/hk2-api.jar,
                                                MICRO-INF/runtime/hk2-utils.jar,
                                                MICRO-INF/runtime/hk2-locator.jar,
                                                MICRO-INF/runtime/jakarta.inject-api.jar,
                                                MICRO-INF/runtime/jakarta.validation-api.jar,
                                                MICRO-INF/runtime/jakarta.ws.rs-api.jar,
                                                MICRO-INF/runtime/jakarta.xml.bind-api.jar,
                                                MICRO-INF/runtime/jakarta.json.bind-api.jar,
                                                MICRO-INF/runtime/jakarta.json.jar,
                                                MICRO-INF/runtime/jaxb-osgi.jar,
                                                MICRO-INF/runtime/yasson.jar,
                                                MICRO-INF/runtime/nucleus-grizzly-all.jar,
                                                MICRO-INF/runtime/jakarta.activation-api.jar,
                                                MICRO-INF/runtime/angus-activation.jar
                                            </includes>
                                        </artifactItem>
                                    </artifactItems>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
